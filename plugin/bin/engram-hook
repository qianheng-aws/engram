#!/usr/bin/env python3
"""Engram hook — fires on session Stop and SessionEnd.

Appends full turn (user + assistant) to pending.jsonl for background processing.
Spawns detached worker to process the queue.
Uses only Python stdlib — no external dependencies.

Works under both Claude Code and Codex CLI: the two harnesses send the same
hook payload fields (session_id, transcript_path, last_assistant_message) but
write transcripts in different formats, both handled by _normalize_entry.
"""

import fcntl
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path


CONFIG_PATH = Path(os.environ.get("ENGRAM_CONFIG", str(Path.home() / ".engram" / "config.json")))
FALLBACK_VAULT = Path.home() / ".engram" / "vault"
# Hard cap on stored turn_text so pending.jsonl cannot balloon; ~20k chars is
# plenty of context for extraction while keeping each append cheap.
MAX_TURN_TEXT = 20000
TRUNCATION_MARKER = "\n\n[...truncated]"
DEFAULT_WORKER_MAX_TURNS_PER_RUN = 20
DEFAULT_WORKER_MIN_BATCH_TURNS = 1
DEFAULT_WORKER_MAX_BATCH_AGE_HOURS = 24


def _cap_turn_text(text):
    """Cap text so the result (marker included) is at most MAX_TURN_TEXT chars."""
    if len(text) > MAX_TURN_TEXT:
        return text[: MAX_TURN_TEXT - len(TRUNCATION_MARKER)] + TRUNCATION_MARKER
    return text


def _load_config():
    try:
        with open(CONFIG_PATH) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _get_vault(config):
    return Path(config.get("vault", str(FALLBACK_VAULT)))


def _feature_enabled(vault_dir, feature):
    """Support split flags while preserving legacy hook-enabled vaults."""
    meta = vault_dir / "_meta"
    capture_flag = meta / "capture-enabled"
    injection_flag = meta / "injection-enabled"
    target = capture_flag if feature == "capture" else injection_flag
    if capture_flag.exists() or injection_flag.exists():
        return target.exists()
    return (meta / "hook-enabled").exists()


def _entry_text(entry):
    """Extract human-readable text from a transcript entry, or "" if none.

    Handles both a flat {"text": ...} shape and the real Claude Code session
    format where text nests under message.content: content is either a plain
    string, or a list of blocks where text lives in {"type": "text",
    "text": ...} blocks (tool_use / tool_result blocks are skipped).
    """
    text = entry.get("text", "")
    if isinstance(text, str) and text.strip():
        return text.strip()

    message = entry.get("message")
    if not isinstance(message, dict):
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return content.strip()
    if isinstance(content, list):
        parts = []
        for block in content:
            if not isinstance(block, dict) or block.get("type") != "text":
                continue
            block_text = block.get("text", "")
            if isinstance(block_text, str) and block_text.strip():
                parts.append(block_text.strip())
        return "\n\n".join(parts)
    return ""


# Codex injects context wrapped in these tags as role=user response items;
# they are harness scaffolding, not something the user typed.
CODEX_INJECTED_PREFIXES = ("<environment_context>", "<user_instructions>",
                           "<permissions", "<turn_context>")


def _codex_entry_text(payload):
    """Extract text from a Codex rollout message payload's content blocks."""
    parts = []
    for block in payload.get("content") or []:
        if not isinstance(block, dict):
            continue
        if block.get("type") not in ("input_text", "output_text"):
            continue
        block_text = block.get("text", "")
        if isinstance(block_text, str) and block_text.strip():
            parts.append(block_text.strip())
    return "\n\n".join(parts)


def _normalize_entry(entry):
    """Return (role, text) for a transcript entry, or (None, "") if not a
    user/assistant message.

    Handles both transcript formats:
    - Claude Code sessions: {"type": "user"|"assistant", "message": {...}}
    - Codex rollouts: {"type": "response_item", "payload": {"type": "message",
      "role": "user"|"assistant", "content": [{"type": "input_text"|
      "output_text", "text": ...}]}}. Codex `event_msg` entries duplicate the
      same content and are ignored; injected user items (environment context,
      user instructions) are dropped so they never masquerade as the prompt.
    """
    entry_type = entry.get("type", "")
    if entry_type in ("user", "assistant"):
        return entry_type, _entry_text(entry)

    if entry_type == "response_item":
        payload = entry.get("payload")
        if not isinstance(payload, dict) or payload.get("type") != "message":
            return None, ""
        role = payload.get("role", "")
        if role not in ("user", "assistant"):
            return None, ""
        text = _codex_entry_text(payload)
        if role == "user" and text.startswith(CODEX_INJECTED_PREFIXES):
            return None, ""
        return role, text

    return None, ""


def _extract_full_turn(transcript_path):
    """Extract the last full turn (user prompt + assistant text) from transcript.

    Returns None if extraction fails for any reason.
    """
    try:
        if not transcript_path or not Path(transcript_path).exists():
            return None

        # Read all lines from transcript
        with open(transcript_path) as f:
            lines = f.readlines()

        if not lines:
            return None

        # Walk backwards, collecting non-empty text until the most recent real
        # user prompt is included. Note: tool_result entries also have type
        # "user" in real transcripts but carry no prompt text (_entry_text
        # returns "" for them), so only a user entry WITH text ends the turn.
        turn_parts = []
        for line in reversed(lines):
            try:
                entry = json.loads(line.strip())
            except (json.JSONDecodeError, ValueError):
                continue
            role, text = _normalize_entry(entry)
            if role is None:
                continue
            if text:
                turn_parts.insert(0, text)
            if role == "user" and text:
                break

        if not turn_parts:
            return None

        return _cap_turn_text("\n\n".join(turn_parts))
    except Exception:
        # Fail silent on any error
        return None


def _pending_batch_ready(vault_dir, config):
    """Return whether spawning a worker can pass the worker batching gate."""
    lock_file = None
    try:
        lock_file = open(vault_dir / "_meta" / "pending.lock", "a+")
        fcntl.flock(lock_file, fcntl.LOCK_SH)
        pending_file = vault_dir / "_meta" / "pending.jsonl"
        if not pending_file.exists():
            return False

        state_file = vault_dir / "_meta" / "worker-state.json"
        offset = 0
        if state_file.exists():
            with open(state_file) as f:
                state = json.load(f)
            offset = state.get("offset", 0)
        file_size = pending_file.stat().st_size
        if not isinstance(offset, int) or offset < 0 or offset > file_size:
            offset = 0
        if offset >= file_size:
            return False

        records = []
        with open(pending_file, "rb") as f:
            f.seek(offset)
            for raw_line in f:
                try:
                    record = json.loads(raw_line)
                    if isinstance(record, dict) and record.get("turn_text"):
                        records.append(record)
                except (ValueError, UnicodeDecodeError):
                    continue

        min_turns = config.get(
            "worker_min_batch_turns", DEFAULT_WORKER_MIN_BATCH_TURNS)
        if not isinstance(min_turns, int) or min_turns < 1:
            min_turns = DEFAULT_WORKER_MIN_BATCH_TURNS
        max_turns = config.get(
            "worker_max_turns_per_run", DEFAULT_WORKER_MAX_TURNS_PER_RUN)
        if isinstance(max_turns, int) and max_turns >= 1:
            min_turns = min(min_turns, max_turns)
        if len(records) >= min_turns:
            return True
        if not records:
            return False

        max_age = config.get(
            "worker_max_batch_age_hours", DEFAULT_WORKER_MAX_BATCH_AGE_HOURS)
        if not isinstance(max_age, (int, float)) or max_age < 0:
            max_age = DEFAULT_WORKER_MAX_BATCH_AGE_HOURS
        try:
            oldest = datetime.fromisoformat(records[0]["timestamp"])
            age_hours = (datetime.now() - oldest).total_seconds() / 3600
        except (KeyError, TypeError, ValueError):
            return True
        return age_hours >= max_age
    except Exception:
        return False
    finally:
        if lock_file is not None:
            lock_file.close()


def _append_pending(vault_dir, record):
    """Append one record under the lock shared with worker compaction."""
    meta_dir = vault_dir / "_meta"
    meta_dir.mkdir(parents=True, exist_ok=True)
    lock_file = open(meta_dir / "pending.lock", "a+")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        with open(meta_dir / "pending.jsonl", "a") as f:
            f.write(json.dumps(record) + "\n")
    finally:
        lock_file.close()


def _spawn_worker(vault_dir):
    """Spawn detached worker process that survives session exit.

    Uses start_new_session=True for full detachment, stdout/stderr to DEVNULL.
    Silently skips if engram is not on PATH.
    """
    try:
        engram_path = shutil.which("engram")
        if not engram_path:
            return  # engram not on PATH, skip silently

        # Spawn fully detached: new session, stdin/stdout/stderr to DEVNULL
        subprocess.Popen(
            [engram_path, "worker"],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
        )
    except Exception:
        # Fail silent on any error
        pass


def main():
    try:
        event_type = sys.argv[1] if len(sys.argv) > 1 else ""
        event_type_lower = event_type.lower()

        config = _load_config()
        vault_dir = _get_vault(config)
        if not _feature_enabled(vault_dir, "capture"):
            return

        if event_type_lower == "stop":
            # Read hook payload from stdin
            try:
                payload = json.load(sys.stdin)
            except (json.JSONDecodeError, ValueError):
                return

            session_id = payload.get("session_id", "unknown")

            # Derive the turn from the transcript first: real Stop payloads
            # carry transcript_path but generally NO last_assistant_message.
            turn_text = _extract_full_turn(payload.get("transcript_path"))
            if turn_text is not None:
                # Substantiveness gate on the transcript-derived turn
                if len(turn_text) < 50:
                    return
            else:
                # Transcript missing/unreadable → fall back to
                # last_assistant_message (if the payload happens to carry it)
                last_message = payload.get("last_assistant_message", "")
                if not isinstance(last_message, str) or len(last_message) < 50:
                    return
                turn_text = _cap_turn_text(last_message)

            # Build record for pending.jsonl
            record = {
                "session_id": session_id,
                "timestamp": datetime.now().isoformat(),
                "turn_text": turn_text,
            }

            # Append to pending.jsonl
            _append_pending(vault_dir, record)

            # Avoid launching a process that would immediately defer.
            if _pending_batch_ready(vault_dir, config):
                _spawn_worker(vault_dir)

        elif event_type_lower == "sessionend":
            # Consume the hook payload so the writer never blocks on a full
            # pipe; the payload itself is not needed on this path.
            try:
                sys.stdin.read()
            except Exception:
                pass

            # SessionEnd: spawn worker if there's unprocessed content
            if _pending_batch_ready(vault_dir, config):
                _spawn_worker(vault_dir)

    except Exception:
        # Fail silent on any error — never raise, never print
        pass


if __name__ == "__main__":
    main()
