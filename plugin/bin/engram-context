#!/usr/bin/env python3
"""Inject compact Engram context at session start or prompt submission.

Modes:
- session: emit the stable cached digest once when a session starts.
- prompt: emit only prompt-matched entities; no match means no injection.

The hook is stdlib-only, size-capped, and fail-silent.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


CONFIG_PATH = Path(os.environ.get("ENGRAM_CONFIG", str(Path.home() / ".engram" / "config.json")))
FALLBACK_VAULT = Path.home() / ".engram" / "vault"
DEFAULT_MAX_CHARS = 1000
DEFAULT_SESSION_MAX_CHARS = 1200
SUBPROCESS_TIMEOUT = 2.0
TRUNCATION_MARKER = "…"
INDEX_VERSIONS = {1, 2}

STOP_WORDS = {
    "THE", "AND", "FOR", "WITH", "FROM", "THAT", "THIS", "HAVE", "HAS",
    "ARE", "WAS", "WERE", "BEEN", "WILL", "CAN", "COULD", "WOULD", "SHOULD",
    "ABOUT", "INTO", "THROUGH", "DURING", "BEFORE", "AFTER", "ABOVE", "BELOW",
    "BETWEEN", "UNDER", "AGAIN", "FURTHER", "THEN", "ONCE", "HERE", "THERE",
    "WHEN", "WHERE", "WHY", "HOW", "ALL", "EACH", "OTHER", "SOME", "SUCH",
    "ONLY", "OWN", "SAME", "THAN", "TOO", "VERY", "JUST", "BUT", "NOT",
}


def _load_config():
    try:
        with open(CONFIG_PATH) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _get_vault(config):
    return Path(config.get("vault", str(FALLBACK_VAULT)))


def _feature_enabled(vault_dir, feature):
    """Support split flags while preserving legacy hook-enabled vaults."""
    meta = vault_dir / "_meta"
    capture_flag = meta / "capture-enabled"
    injection_flag = meta / "injection-enabled"
    target = capture_flag if feature == "capture" else injection_flag
    if capture_flag.exists() or injection_flag.exists():
        return target.exists()
    return (meta / "hook-enabled").exists()


def _configured_limit(config, key, default):
    value = config.get(key, default)
    return value if isinstance(value, int) and value >= 0 else default


def _cjk_ngrams(text):
    terms = []
    for run in re.findall(r"[\u3400-\u9fff]+", text):
        for width in range(2, min(4, len(run)) + 1):
            terms.extend(run[i:i + width] for i in range(len(run) - width + 1))
    return terms


def _extract_terms(text):
    ascii_terms = [
        token.lower()
        for token in re.findall(r"[a-zA-Z0-9]+", text)
        if len(token) >= 3 and token.upper() not in STOP_WORDS
    ]
    return list(dict.fromkeys(ascii_terms + _cjk_ngrams(text)))


def _read_cache(vault_dir):
    try:
        return (vault_dir / "_meta" / "context-cache.md").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def _run_engram(args):
    engram_bin = shutil.which("engram")
    if not engram_bin:
        return None
    try:
        result = subprocess.run(
            [engram_bin, *args], capture_output=True, text=True,
            timeout=SUBPROCESS_TIMEOUT,
        )
        if result.returncode == 0:
            return json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def _fallback_context(vault_dir):
    data = _run_engram(["context", "--vault", str(vault_dir)])
    return data.get("context", "").strip() if isinstance(data, dict) else ""


def _load_entity_index(vault_dir):
    try:
        with open(vault_dir / "_meta" / "entity-index.json", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict) or data.get("version") not in INDEX_VERSIONS:
            return None
        entities = data.get("entities")
        if not isinstance(entities, dict):
            return None

        index = {}
        for name, entry in entities.items():
            if not isinstance(entry, dict):
                continue
            keywords = entry.get("keywords")
            snippet = entry.get("snippet")
            local_path = entry.get("local_path", "")
            if not isinstance(keywords, list) or not isinstance(snippet, str):
                continue
            index[name] = {
                "keywords": {kw.lower() for kw in keywords if isinstance(kw, str)},
                "snippet": snippet,
                "local_path": local_path if isinstance(local_path, str) else "",
            }
        return index
    except (OSError, ValueError):
        return None


def _path_affinity(cwd, local_path):
    if not cwd or not local_path:
        return 0
    try:
        cwd = os.path.realpath(cwd)
        local_path = os.path.realpath(local_path)
        if cwd == local_path or cwd.startswith(local_path + os.sep):
            return 2
        if local_path.startswith(cwd + os.sep):
            return 1
    except (OSError, ValueError):
        pass
    return 0


def _match_entities_from_index(index, terms, cwd=""):
    if not terms:
        return []
    term_set = set(terms)
    scored = []
    for name, entry in index.items():
        matches = len(term_set & entry["keywords"])
        if not matches:
            continue
        affinity = _path_affinity(cwd, entry["local_path"])
        score = matches * 10 + affinity * 3
        scored.append((score, matches, name, entry["snippet"]))
    scored.sort(key=lambda item: (-item[0], -item[1], item[2]))
    return scored[:5]


def _format_query_result(data):
    if not isinstance(data, dict):
        return ""
    parts = []
    matched = data.get("matched_entities", [])
    if matched:
        parts.append(f"**Matched:** {', '.join(matched[:5])}")
    expanded = data.get("expanded_entities", [])
    if expanded:
        parts.append(f"**Related:** {', '.join(e['name'] for e in expanded[:5] if 'name' in e)}")
    context = data.get("context", "").strip()
    if context:
        compact = []
        for line in context.splitlines()[:15]:
            line = line.strip()
            if line.startswith("##") or (line and not line.startswith("#")):
                compact.append(line)
        if compact:
            parts.append("\n".join(compact))
    return "\n".join(parts)


def _query_subgraph(vault_dir, terms, cwd=""):
    if not terms:
        return ""
    index = _load_entity_index(vault_dir)
    if index is not None:
        matches = _match_entities_from_index(index, terms, cwd)
        return "\n".join(item[3] for item in matches)

    data = _run_engram([
        "query", "--question", " ".join(terms[:12]),
        "--vault", str(vault_dir),
    ])
    return _format_query_result(data)


def _cap_block(header, content, max_chars):
    if not content or max_chars <= len(header):
        return ""
    available = max_chars - len(header)
    if len(content) > available:
        content = content[:max(0, available - len(TRUNCATION_MARKER))] + TRUNCATION_MARKER
    return header + content


def _build_session_context(vault_dir, config):
    digest = _read_cache(vault_dir) or _fallback_context(vault_dir)
    return _cap_block(
        "## Engram Session Memory\n\n",
        digest,
        _configured_limit(config, "context_session_max_chars", DEFAULT_SESSION_MAX_CHARS),
    )


def _build_prompt_context(vault_dir, config, prompt, cwd=""):
    matched = _query_subgraph(vault_dir, _extract_terms(prompt), cwd)
    return _cap_block(
        "## Memory Context\n\n",
        matched,
        _configured_limit(config, "context_max_chars", DEFAULT_MAX_CHARS),
    )


def main():
    try:
        mode = sys.argv[1].lower() if len(sys.argv) > 1 else "prompt"
        if mode not in ("prompt", "session"):
            return

        config = _load_config()
        vault_dir = _get_vault(config)
        if not _feature_enabled(vault_dir, "injection"):
            return

        try:
            payload = json.load(sys.stdin)
        except (ValueError, OSError):
            return
        if not isinstance(payload, dict):
            return

        if mode == "session":
            memory_context = _build_session_context(vault_dir, config)
        else:
            prompt = payload.get("prompt", "")
            if not isinstance(prompt, str) or not prompt:
                return
            cwd = payload.get("cwd", "")
            memory_context = _build_prompt_context(
                vault_dir, config, prompt,
                cwd if isinstance(cwd, str) else "",
            )
        if memory_context:
            print(memory_context)
    except Exception:
        pass


if __name__ == "__main__":
    main()
