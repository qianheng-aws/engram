{
    "description": "Engram — persistent memory via knowledge graph",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Grep|Glob|Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/bin/engram-pretool",
                        "timeout": 3000
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/bin/engram-hook Stop",
                        "timeout": 5000
                    }
                ]
            }
        ]
    }
}
